# 测试环境配置
# 继承 .env 文件的配置，并覆盖测试环境特定的配置

# 应用标题（测试环境）
VITE_APP_TITLE=DocLogic (Testing)

# 环境标识
VITE_APP_ENV=testing

# API 配置（测试环境 - 通常指向本地或测试服务器）
VITE_GLOB_API_URL=/api
VITE_APP_API_BASE_URL=http://192.168.1.2:8500

# 测试环境功能开关
VITE_GLOB_APP_PWA=false
VITE_USE_LAZY_LOADING=false

# 文件上传配置
VITE_UPLOAD_URL=/startTask

# 谷歌登录配置（测试环境可以使用开发环境的配置）
VITE_GOOGLE_CLIENT_ID=765574459971-klc3ugs1c5u2be7jfkv1s1dpe3ek78t4.apps.googleusercontent.com

# 构建优化配置（测试环境保留所有调试信息）
VITE_BUILD_COMPRESS=none
VITE_BUILD_DROP_CONSOLE=false
