# alpharadars 基础环境配置文件
# 此文件包含所有环境的默认配置，会被具体环境文件覆盖

# 应用基础信息
VITE_APP_TITLE=alpharadars
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# 开发服务器配置
VITE_DEV_SERVER_PORT=8200
VITE_DEV_SERVER_HOST=0.0.0.0

# API 配置
VITE_GLOB_API_URL=/api
VITE_APP_API_BASE_URL=http://192.168.1.2:8500

# 功能开关
VITE_GLOB_APP_PWA=false
VITE_USE_LAZY_LOADING=true

# 文件上传配置
VITE_UPLOAD_URL=/startTask

# OnlyOffice Document Server 配置
VITE_ONLYOFFICE_URL=http://192.168.1.7:9000/

# 谷歌登录配置（开发环境默认值）
VITE_GOOGLE_CLIENT_ID=765574459971-klc3ugs1c5u2be7jfkv1s1dpe3ek78t4.apps.googleusercontent.com
