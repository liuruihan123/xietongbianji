# 预发布环境配置
# 继承 .env 文件的配置，并覆盖预发布环境特定的配置

# 应用标题（预发布环境）
VITE_APP_TITLE=DocLogic (Staging)

# 环境标识
VITE_APP_ENV=staging

# API 配置（预发布环境 - 通常指向测试服务器）
VITE_GLOB_API_URL=/api
VITE_APP_API_BASE_URL=https://staging-api.your-domain.com

# 预发布环境功能开关
VITE_GLOB_APP_PWA=true
VITE_USE_LAZY_LOADING=true

# 文件上传配置
VITE_UPLOAD_URL=/startTask

# 谷歌登录配置（预发布环境）
VITE_GOOGLE_CLIENT_ID=your-staging-google-client-id.apps.googleusercontent.com

# 构建优化配置（预发布环境保留 console 用于调试）
VITE_BUILD_COMPRESS=gzip
VITE_BUILD_DROP_CONSOLE=false
