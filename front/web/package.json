{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:port": "vite --host --port 3006",
    "dev:staging": "vite --host --mode staging",
    "build": "vue-tsc && vite build",
    "build:dev": "vue-tsc && vite build --mode development",
    "build:staging": "vue-tsc && vite build --mode staging",
    "build:prod": "vite build --mode production",
    "build:prod:check": "vue-tsc --skipLibCheck && vite build --mode production",
    "build:test": "vue-tsc && vite build --mode testing",
    "preview": "vite preview",
    "preview:staging": "vite preview --mode staging",
    "preview:prod": "vite preview --mode production",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx --fix --ignore-path .gitignore",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@stomp/stompjs": "^7.2.1",
    "@tato30/vue-pdf": "^1.11.5",
    "@types/qrcode": "^1.5.6",
    "@types/sockjs-client": "^1.5.4",
    "ant-design-vue": "^3.2.20",
    "axios": "^1.11.0",
    "dompurify": "^3.2.6",
    "google-auth-library": "^10.3.0",
    "highlight.js": "^11.11.1",
    "lodash-es": "^4.17.21",
    "marked": "^16.2.1",
    "mitt": "^3.0.1",
    "pinia": "^2.1.7",
    "qrcode": "^1.5.4",
    "sockjs-client": "^1.6.1",
    "v-viewer": "^3.0.22",
    "viewerjs": "^1.11.7",
    "vue": "^3.5.18",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.5.1",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/lodash": "^4.17.20",
    "@types/lodash-es": "^4.17.12",
    "@types/marked": "^5.0.2",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "sass": "^1.69.5",
    "sass-embedded": "^1.91.0",
    "tailwindcss": "^3.4.17",
    "terser": "^5.44.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vue-tsc": "^3.0.6"
  }
}
