# 生产环境配置
# 继承 .env 文件的配置，并覆盖生产环境特定的配置

# 应用标题（生产环境）
VITE_APP_TITLE=协同编辑系统

# 环境标识
VITE_APP_ENV=production

# 开发服务器配置
VITE_DEV_SERVER_PORT=80
VITE_DEV_SERVER_HOST=0.0.0.0

VITE_SERVER_IP=http://34.200.2.14

# API 配置（生产环境 - 需要修改为实际的服务器地址）
VITE_GLOB_API_URL=/api
# VITE_APP_API_BASE_URL=http://192.168.1.2:8500
VITE_APP_API_BASE_URL=http://34.200.2.14:8500
# 生产环境功能开关
VITE_GLOB_APP_PWA=true

# 文件上传配置
VITE_UPLOAD_URL=/startTask

# 谷歌登录配置（生产环境需要替换为实际的客户端ID）
VITE_GOOGLE_CLIENT_ID=your-production-google-client-id.apps.googleusercontent.com

# OnlyOffice Document Server地址
VITE_ONLYOFFICE_URL=http://34.200.2.14:9000/


# 构建优化配置
VITE_BUILD_COMPRESS=gzip
VITE_BUILD_DROP_CONSOLE=true
