# 开发环境配置
# 继承 .env 文件的配置，并覆盖开发环境特定的配置

# 应用标题（开发环境显示）
VITE_APP_TITLE=汇众协同编辑系统

# 环境标识
VITE_APP_ENV=development

# API 配置（开发环境使用本地代理）
VITE_GLOB_API_URL=/api
VITE_APP_API_BASE_URL=http://localhost:8500

# 开发服务器配置（开发环境使用固定端口）
VITE_DEV_SERVER_PORT=8501
VITE_DEV_SERVER_HOST=0.0.0.0

VITE_SERVER_IP=http://localhost

# 开发环境功能开关
VITE_GLOB_APP_PWA=false
VITE_DEV_MOCK=false
VITE_DEV_PROXY=true

# 构建配置
VITE_BUILD_DROP_CONSOLE=false

# 谷歌登录配置（开发环境默认值）
VITE_GOOGLE_CLIENT_ID=765574459971-klc3ugs1c5u2be7jfkv1s1dpe3ek78t4.apps.googleusercontent.com

# OnlyOffice Document Server地址
VITE_ONLYOFFICE_URL=http://192.168.1.7:9000/
